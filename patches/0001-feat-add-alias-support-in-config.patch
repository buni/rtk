+    let trimmed = cmd.trim();
+    if !trimmed.starts_with("rtk ") {
+        let aliases = &config.aliases.map;
+        let alias_match = aliases
+            .keys()
+            .filter(|prefix| {
+                let p = prefix.as_str();
+                trimmed == p || trimmed.starts_with(&format!("{} ", p))
+            })
+            .max_by_key(|p| p.len());
+
+        if alias_match.is_some() {
+            print!("rtk {}", trimmed);
+            return Ok(());
+        }
+    }
 
